# Copy this file to .env.local and fill in real keys.
# .env.local is gitignored.

# ─── Supabase (https://supabase.com/dashboard)
# 1. New project → region: ap-northeast-2 (Seoul)
# 2. Settings → API: URL, anon key, service_role key
# 3. Settings → Database → Connection string:
#    - Pooler (transaction mode) → DATABASE_URL  (런타임 쿼리용)
#    - Direct connection         → DIRECT_URL    (prisma migrate 전용)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=

# ─── 카카오맵 (https://developers.kakao.com)
# 1. 카카오 개발자 콘솔 → 앱 만들기
# 2. 앱 키 → JavaScript 키 (클라이언트 SDK용)
# 3. 앱 키 → REST API 키 (서버 주소검색용)
# 4. 플랫폼 → Web → 사이트 도메인 등록 (http://localhost:3000)
NEXT_PUBLIC_KAKAO_JS_KEY=
KAKAO_REST_API_KEY=

# ─── 차량정보 조회 (선택)
# mock | apick | datahub  (없으면 mock)
VEHICLE_LOOKUP_PROVIDER=mock
APICK_API_KEY=
DATAHUB_API_KEY=
