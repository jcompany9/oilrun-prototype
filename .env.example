# Copy this file to .env.local and fill in real keys.
# .env.local is gitignored.

# ─── 카카오맵 (https://developers.kakao.com)
# 1. 카카오 개발자 콘솔 → 앱 만들기
# 2. 앱 키 → JavaScript 키 (클라이언트 SDK용)
# 3. 앱 키 → REST API 키 (서버 주소검색용)
# 4. 플랫폼 → Web → 사이트 도메인 등록 (http://localhost:3000)
NEXT_PUBLIC_KAKAO_JS_KEY=
KAKAO_REST_API_KEY=

# ─── 차량정보 조회 (선택)
# mock | apick | datahub  (없으면 mock)
VEHICLE_LOOKUP_PROVIDER=mock
APICK_API_KEY=
DATAHUB_API_KEY=
